<svg width="1200" height="800" xmlns="http://www.w3.org/2000/svg">
  <!-- Background gradient -->
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="1200" height="800" fill="url(#bg)"/>
  
  <!-- Header banner -->
  <rect x="0" y="0" width="1200" height="60" fill="#8e44ad"/>
  <text x="20" y="35" font-family="Arial" font-size="16" fill="white" font-weight="bold">🚀 Spring Hibernate Demo</text>
  <text x="20" y="50" font-family="Arial" font-size="12" fill="#ecf0f1">Application moderne de gestion de produits et catégories</text>
  
  <!-- Navigation -->
  <rect x="20" y="80" width="100" height="40" fill="#3498db" rx="5"/>
  <text x="50" y="103" font-family="Arial" font-size="14" fill="white" text-anchor="middle">Accueil</text>
  
  <rect x="130" y="80" width="100" height="40" fill="#ecf0f1" rx="5"/>
  <text x="160" y="103" font-family="Arial" font-size="14" fill="#666" text-anchor="middle">Produits</text>
  
  <rect x="240" y="80" width="100" height="40" fill="#ecf0f1" rx="5"/>
  <text x="270" y="103" font-family="Arial" font-size="14" fill="#666" text-anchor="middle">Catégories</text>
  
  <!-- Main content -->
  <rect x="50" y="150" width="1100" height="500" fill="white" rx="10" opacity="0.95"/>
  
  <!-- Welcome section -->
  <text x="100" y="200" font-family="Arial" font-size="28" fill="#2c3e50" font-weight="bold">✨ Bienvenue dans l'Application</text>
  <text x="100" y="230" font-family="Arial" font-size="14" fill="#666">Découvrez une application web moderne développée avec Spring Framework, Hibernate ORM et Thymeleaf.</text>
  
  <!-- Stats cards -->
  <rect x="100" y="270" width="200" height="80" fill="#3498db" rx="5"/>
  <text x="200" y="300" font-family="Arial" font-size="24" fill="white" font-weight="bold" text-anchor="middle">15+</text>
  <text x="200" y="320" font-family="Arial" font-size="14" fill="white" text-anchor="middle">Produits</text>
  
  <rect x="320" y="270" width="200" height="80" fill="#e74c3c" rx="5"/>
  <text x="420" y="300" font-family="Arial" font-size="24" fill="white" font-weight="bold" text-anchor="middle">4</text>
  <text x="420" y="320" font-family="Arial" font-size="14" fill="white" text-anchor="middle">Catégories</text>
  
  <rect x="540" y="270" width="200" height="80" fill="#27ae60" rx="5"/>
  <text x="640" y="300" font-family="Arial" font-size="24" fill="white" font-weight="bold" text-anchor="middle">10</text>
  <text x="640" y="320" font-family="Arial" font-size="14" fill="white" text-anchor="middle">Tests Réussis</text>
  
  <rect x="760" y="270" width="200" height="80" fill="#f39c12" rx="5"/>
  <text x="860" y="300" font-family="Arial" font-size="24" fill="white" font-weight="bold" text-anchor="middle">100%</text>
  <text x="860" y="320" font-family="Arial" font-size="14" fill="white" text-anchor="middle">Success Rate</text>
  
  <!-- Features section -->
  <text x="100" y="400" font-family="Arial" font-size="20" fill="#2c3e50" font-weight="bold">✨ Fonctionnalités</text>
  
  <!-- Feature cards -->
  <rect x="100" y="420" width="300" height="120" fill="#667eea" rx="5"/>
  <text x="120" y="440" font-family="Arial" font-size="14" fill="white" font-weight="bold">📦 Gestion des Produits</text>
  <text x="120" y="460" font-family="Arial" font-size="11" fill="white">Créez, modifiez et supprimez des produits.</text>
  
  <rect x="420" y="420" width="300" height="120" fill="#667eea" rx="5"/>
  <text x="440" y="440" font-family="Arial" font-size="14" fill="white" font-weight="bold">📁 Gestion des Catégories</text>
  <text x="440" y="460" font-family="Arial" font-size="11" fill="white">Organisez vos produits par catégories.</text>
  
  <rect x="740" y="420" width="300" height="120" fill="#667eea" rx="5"/>
  <text x="760" y="440" font-family="Arial" font-size="14" fill="white" font-weight="bold">🔗 Relations JPA</text>
  <text x="760" y="460" font-family="Arial" font-size="11" fill="white">Relations ManyToOne et OneToMany.</text>
  
  <!-- Action buttons -->
  <rect x="100" y="580" width="200" height="50" fill="#3498db" rx="25"/>
  <text x="200" y="610" font-family="Arial" font-size="16" fill="white" text-anchor="middle">Voir les Produits</text>
  
  <rect x="320" y="580" width="200" height="50" fill="#e91e63" rx="25"/>
  <text x="420" y="610" font-family="Arial" font-size="16" fill="white" text-anchor="middle">Voir les Catégories</text>
  
  <!-- Technologies -->
  <text x="100" y="680" font-family="Arial" font-size="16" fill="white" font-weight="bold">⚙️ Technologies Utilisées</text>
  <text x="100" y="700" font-family="Arial" font-size="12" fill="white">Java 17 • Spring 5.3 • Hibernate 5.6 • MySQL 8.0 • Thymeleaf • JUnit 5 • Mockito • Maven</text>
</svg>
