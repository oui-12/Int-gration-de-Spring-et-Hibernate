<svg width="1200" height="800" xmlns="http://www.w3.org/2000/svg">
  <!-- Background gradient -->
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="1200" height="800" fill="url(#bg)"/>
  
  <!-- Header card -->
  <rect x="400" y="50" width="400" height="80" fill="white" rx="10" opacity="0.95"/>
  <text x="600" y="90" font-family="Arial" font-size="32" fill="#8e44ad" font-weight="bold" text-anchor="middle">+ Produit</text>
  
  <!-- Navigation card -->
  <rect x="300" y="150" width="600" height="60" fill="white" rx="10" opacity="0.95"/>
  
  <!-- Navigation buttons -->
  <rect x="320" y="170" width="120" height="40" fill="#8e44ad" rx="5"/>
  <text x="380" y="193" font-family="Arial" font-size="14" fill="white" text-anchor="middle">🏠 Accueil</text>
  
  <rect x="450" y="170" width="120" height="40" fill="#8e44ad" rx="5"/>
  <text x="510" y="193" font-family="Arial" font-size="14" fill="white" text-anchor="middle">📦 Produits</text>
  
  <rect x="580" y="170" width="120" height="40" fill="#ecf0f1" rx="5"/>
  <text x="640" y="193" font-family="Arial" font-size="14" fill="#666" text-anchor="middle">📁 Catégories</text>
  
  <!-- Form card -->
  <rect x="200" y="230" width="800" height="400" fill="white" rx="10" opacity="0.95"/>
  
  <!-- Form title -->
  <text x="600" y="270" font-family="Arial" font-size="20" fill="#2c3e50" font-weight="bold" text-anchor="middle">Ajouter un Nouveau Produit</text>
  
  <!-- Form fields -->
  <!-- Product Name -->
  <text x="250" y="320" font-family="Arial" font-size="14" fill="#2c3e50" font-weight="bold">📍 Nom du produit</text>
  <rect x="250" y="330" width="500" height="40" fill="#f8f9fa" stroke="#dee2e6" rx="5"/>
  <text x="260" y="352" font-family="Arial" font-size="12" fill="#6c757d">Ex: iPhone 15 Pro</text>
  
  <!-- Price -->
  <text x="250" y="400" font-family="Arial" font-size="14" fill="#2c3e50" font-weight="bold">💰 Prix (€)</text>
  <rect x="250" y="410" width="500" height="40" fill="#f8f9fa" stroke="#dee2e6" rx="5"/>
  <text x="260" y="432" font-family="Arial" font-size="12" fill="#6c757d">Ex: 1299.99</text>
  
  <!-- Category -->
  <text x="250" y="480" font-family="Arial" font-size="14" fill="#2c3e50" font-weight="bold">📁 Catégorie</text>
  <rect x="250" y="490" width="500" height="40" fill="#f8f9fa" stroke="#dee2e6" rx="5"/>
  <text x="260" y="512" font-family="Arial" font-size="12" fill="#6c757d">-- Aucune catégorie --</text>
  
  <!-- Action buttons -->
  <rect x="400" y="560" width="120" height="50" fill="#27ae60" rx="25"/>
  <text x="460" y="590" font-family="Arial" font-size="16" fill="white" text-anchor="middle">💾 Enregistrer</text>
  
  <rect x="540" y="560" width="120" height="50" fill="#6c757d" rx="25"/>
  <text x="600" y="590" font-family="Arial" font-size="16" fill="white" text-anchor="middle">✕ Annuler</text>
  
  <!-- Left sidebar -->
  <rect x="0" y="0" width="80" height="800" fill="#2c3e50"/>
  
  <!-- Sidebar icons -->
  <text x="40" y="50" font-family="Arial" font-size="20" fill="#ecf0f1" text-anchor="middle">📁</text>
  <text x="40" y="100" font-family="Arial" font-size="20" fill="#ecf0f1" text-anchor="middle">🔍</text>
  <text x="40" y="150" font-family="Arial" font-size="20" fill="#ecf0f1" text-anchor="middle">📝</text>
  <text x="40" y="200" font-family="Arial" font-size="20" fill="#ecf0f1" text-anchor="middle">🗄️</text>
  <text x="40" y="250" font-family="Arial" font-size="20" fill="#ecf0f1" text-anchor="middle">💻</text>
  <text x="40" y="300" font-family="Arial" font-size="20" fill="#ecf0f1" text-anchor="middle">☁️</text>
  <text x="40" y="350" font-family="Arial" font-size="20" fill="#ecf0f1" text-anchor="middle">🔧</text>
  <text x="40" y="400" font-family="Arial" font-size="20" fill="#ecf0f1" text-anchor="middle">📱</text>
  <text x="40" y="450" font-family="Arial" font-size="20" fill="#ecf0f1" text-anchor="middle">📺</text>
  <text x="40" y="500" font-family="Arial" font-size="20" fill="#ecf0f1" text-anchor="middle">🌐</text>
</svg>
